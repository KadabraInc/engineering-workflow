{
  "schema_version": 1,
  "stack": "go",
  "test": {
    "command": "go test ./...",
    "targeted_command": "go test -run {pattern} ./...",
    "match": "go test",
    "fail_patterns": ["^FAIL", "--- FAIL"],
    "fail_count_pattern": ""
  },
  "globs": {
    "source": ["**/*.go"],
    "test": ["**/*_test.go"],
    "exempt": ["**/*.md", "docs/**", ".claude/**", ".github/**", "**/*.yml", "**/*.yaml",
               "go.sum", "vendor/**", "**/*.pb.go", "**/*_gen.go"],
    "protected": [".golangci.yml", ".golangci.yaml"]
  },
  "tdd": {
    "enabled": true,
    "default_class": "source",
    "staleness_minutes": 240,
    "green_edit_budget": 5,
    "refactor_budget": 25
  },
  "hooks": { "enabled": true, "ambient_profile": "standard", "pipeline_profile": "strict" },
  "delivery": { "min_source_files": 3, "retry_failed": 0 },
  "knowledge": { "dir": ".claude/knowledge" },
  "search_exclude": [".claude/team/artifacts/**", ".claude/knowledge/lessons/**", ".code-review-graph/**", "vendor/**"],
  "branch_prefix": "team/",
  "graph": { "enabled": true }
}

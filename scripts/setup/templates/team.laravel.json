{
  "schema_version": 1,
  "stack": "laravel",
  "test": {
    "command": "__TEST_CMD__",
    "targeted_command": "__TARGETED_CMD__",
    "match": "artisan test|phpunit|pest",
    "fail_patterns": ["FAILURES?!", "[1-9][0-9]* failed", "Failures: [1-9][0-9]*"],
    "fail_count_pattern": "([0-9]+ failed|Failures: [0-9]+)"
  },
  "globs": {
    "source": ["app/**", "routes/**", "resources/views/**", "config/**"],
    "test": ["tests/**"],
    "exempt": ["**/*.md", "docs/**", ".claude/**", ".github/**", "**/*.yml", "**/*.yaml",
               "database/migrations/**", "database/seeders/**", "database/factories/**",
               "composer.lock", "public/**", "storage/**", "bootstrap/cache/**",
               "resources/css/**", "resources/js/vendor/**", "lang/**", "**/*.css"],
    "protected": ["phpunit.xml", "phpunit.xml.dist", "pest.config.php", ".php-cs-fixer*", "pint.json"]
  },
  "tdd": {
    "enabled": true,
    "default_class": "source",
    "staleness_minutes": 240,
    "green_edit_budget": 5,
    "refactor_budget": 25
  },
  "hooks": { "enabled": true, "ambient_profile": "standard", "pipeline_profile": "strict" },
  "delivery": { "min_source_files": 3, "retry_failed": 0 },
  "knowledge": { "dir": ".claude/knowledge" },
  "search_exclude": [".claude/team/artifacts/**", ".claude/knowledge/lessons/**", ".code-review-graph/**", "vendor/**"],
  "branch_prefix": "team/",
  "graph": { "enabled": true }
}
